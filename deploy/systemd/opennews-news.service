[Unit]
Description=6551 OpenNews news collector
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/trading/news
ExecStart=/usr/bin/docker compose run --rm opennews-collector --profile news --engine-type news --adaptive-pages --min-pages 3 --max-pages 20 --page-step 2
TimeoutStartSec=10min
